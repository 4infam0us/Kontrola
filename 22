    def pom_dodaj_pomiar(self):
        plan = self._plan_as_dict_for_measure(); cechy = plan.get("cechy", [])
        if not cechy: messagebox.showwarning("Pomiary","Najpierw wybierz plan pomiarowy."); return
        wybr = self.cb_pom_cecha.get().strip()
        try: idx = int(wybr.split(".",1)[0]) - 1
        except Exception: messagebox.showwarning("Pomiary","Wybierz cechę"); return
        if not (0 <= idx < len(cechy)): messagebox.showwarning("Pomiary","Niepoprawny wybór cechy"); return
        try: val = float(str(self.ent_pom_val.get()).replace(",", "."))
        except Exception: messagebox.showwarning("Pomiary","Wpisz liczbową wartość"); return

        c = cechy[idx]
        label, nom_txt, lsl, usl, nom = self._cecha_label_i_zakres(c)
        if lsl > usl:
            lsl, usl = usl, lsl
        wynik = "OK" if (lsl <= val <= usl) else "NOK"
        odch = val - nom
        zapas = min(val - lsl, usl - val)  # dodatni = ile „zapasu” do najbliższego limitu
        kto = self.cb_pom_kto.get().strip() or c.get("kto_mierzy","")
        narz = c.get("narzedzie","")

        rec = {
            "timestamp": _now_str(),
            "nr_szt": self.ent_pom_nr.get().strip() or "-",
            "idx_cechy": idx+1,
            "opis_cechy": label,
            "wartosc": val,
            "odchylka": odch,
            "zapas": zapas,
            "wynik": wynik,
            "kto_mierzy": kto,
            "narzedzie": narz,
            "nominal": nom, "lsl": lsl, "usl": usl,
        }
