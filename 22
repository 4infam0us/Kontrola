    def _parse_date(self, s): return _parse_date(s)

    def _szukaj(self):
        fraza = self.ent_fraza.get().strip().lower(); filtr_autor = self.cb_autor.get()
        d_od = self._parse_date(self.ent_od.get()); d_do = self._parse_date(self.ent_do.get())
        for i in self.tv.get_children(): self.tv.delete(i)

        wzorce = [os.path.join(self.katalog, "**", "*.json"), os.path.join(self.katalog, "**", "*.csv")]
        matches = []
        for wz in wzorce: matches.extend(glob.glob(wz, recursive=True))

        def pass_date(dt_str):
            try: dt = datetime.date.fromisoformat(dt_str)
            except Exception: return True
            if d_od and dt < d_od: return False
            if d_do and dt > d_do: return False
            return True

        for path in sorted(matches):
            name = os.path.basename(path).lower()
            if fraza and fraza not in name:
                if path.lower().endswith(".json"):
                    try:
                        j = _load_json(path); meta = j.get("metadane", {})
                        test_str = f"{meta.get('nr_rysunku','')} {meta.get('autor','')}".lower()
                        if fraza not in test_str: continue
                    except Exception: continue
                else:
                    continue

            nr=autor=data=czest=""
            if path.lower().endswith(".json"):
                try:
                    j=_load_json(path); m=j.get("metadane", {})
                    nr=m.get("nr_rysunku",""); autor=m.get("autor",""); data=m.get("data",""); czest=m.get("czestotliwosc","")
                except Exception: pass
            else:
                try:
                    with open(path, "r", encoding="utf-8-sig") as f:
                        lines=[next(f) for _ in range(8)]
                    for ln in lines:
                        if ln.startswith("# Nr rysunku;"): nr = ln.split(";",1)[1].strip()
                        elif ln.startswith("# Autor;"): autor = ln.split(";",1)[1].strip()
                        elif ln.startswith("# Data;"): data = ln.split(";",1)[1].strip()
                        elif ln.startswith("# Częstotliwość;"): czest = ln.split(";",1)[1].strip()
                except Exception: pass

            if filtr_autor != "(dowolny)" and autor != filtr_autor: continue
            if data and not pass_date(data): continue

            self.tv.insert("", tk.END, values=(nr, autor, data, czest, path))

class DialogProwadzonePomiary(tk.Toplevel):
    """
    Duże okno prowadzące cecha→wartość→dalej.
    Zwraca listę rekordów pomiarów przez callback on_finish(list_of_records).
    """
    def __init__(self, master, cechy_seq, nr_szt, rola, on_finish, on_progress=None, on_cancel=None, existing=None):
        super().__init__(master)
        self.title("Prowadzone pomiary")
        self.geometry("760x420"); self.minsize(720, 380)
        self.transient(master); self.grab_set()
        self.cechy = cechy_seq[:]   # lista cech (słowniki z planu)
        self.nr_szt = nr_szt
        self.rola = rola
        self.on_finish = on_finish
        self.on_progress = on_progress
        self.on_cancel = on_cancel
        self.idx = 0
        self.rekordy = []  # buforowane pomiary dla tej sztuki
        if existing and isinstance(existing, dict):
            existing_records = existing.get("records") or []
            if isinstance(existing_records, list):
                self.rekordy = [dict(r) for r in existing_records]
            try:
                existing_nr = existing.get("nr_szt")
                if existing_nr:
                    self.nr_szt = str(existing_nr)
            except Exception:
                pass
            if existing.get("rola"):
                self.rola = existing.get("rola")
            self.idx = min(len(self.rekordy), max(0, len(self.cechy) - 1))


        # UI
        frm = ttk.Frame(self, padding=16)
        frm.pack(fill="both", expand=True)

        self.lbl_top = ttk.Label(frm, text=f"Sztuka #{self.nr_szt}  •  Rola: {self.rola}", font=("Segoe UI", 11, "bold"))
        self.lbl_top.pack(anchor="w", pady=(0,8))

        self.lbl_cecha = ttk.Label(frm, text="", font=("Segoe UI", 10, "bold"))
        self.lbl_cecha.pack(anchor="w")

        self.lbl_nom = ttk.Label(frm, text="", foreground="#333")
        self.lbl_nom.pack(anchor="w", pady=(2,2))

        self.lbl_tol = ttk.Label(frm, text="", foreground="#333")
        self.lbl_tol.pack(anchor="w")

        big = ttk.Frame(frm)
        big.pack(fill="x", pady=(16,0))
        ttk.Label(big, text="Wpisz wartość:", font=("Segoe UI", 11)).pack(side="left")
        self.ent_val = ttk.Entry(big, width=18, font=("Consolas", 13))
        self.ent_val.pack(side="left", padx=10)
        self.ent_val.bind("<Return>", lambda e: self._zap_next())

        nav = ttk.Frame(frm)
        nav.pack(fill="x", pady=16)
        self.btn_back = ttk.Button(nav, text="◀  Wstecz", command=self._back)
        self.btn_back.pack(side="left")
        self.btn_next = ttk.Button(nav, text="Dalej  ▶", command=self._zap_next)
        self.btn_next.pack(side="right")
        ttk.Button(nav, text="Anuluj", command=self._cancel).pack(side="right", padx=6)

        self._show_step()

    def _fmt_float(self, x):
        try:
            return float(str(x).replace(",", "."))
        except Exception:
            return None

    def _show_step(self):
        c = self.cechy[self.idx]
        typ=c.get("typ",""); opis=c.get("opis","")
        nom = self._fmt_float(c.get("nominal","") or 0.0) or 0.0
        lsl = nom + (self._fmt_float(c.get("tol_minus","") or 0.0) or 0.0)
        usl = nom + (self._fmt_float(c.get("tol_plus","") or 0.0) or 0.0)
        # napraw jeżeli ktoś podał odwrócone
        if lsl > usl: lsl, usl = usl, lsl

        self._cur_spec = (nom, lsl, usl)
        self._cur_label = f"{typ}: {opis}"
        self._cur_narz = c.get("narzedzie","")

        self.lbl_cecha.config(text=f"{self.idx+1}/{len(self.cechy)}  •  {self._cur_label}")
        self.lbl_nom.config(text=f"Nominal: {c.get('nominal','')} {c.get('jednostka','')}".strip())
        self.lbl_tol.config(text=f"OK, jeśli ∈ [{lsl:.6f}; {usl:.6f}]")

        # reset pola
        self.ent_val.delete(0, tk.END)
        self.ent_val.focus_set()

        self.btn_back.configure(state=("disabled" if self.idx==0 else "normal"))
        self.btn_next.configure(text=("Zakończ" if self.idx==len(self.cechy)-1 else "Dalej  ▶"))

    def _zap_next(self):
        v = self._fmt_float(self.ent_val.get())
        if v is None:
            messagebox.showwarning("Wartość", "Podaj liczbową wartość.")
            return
        nom, lsl, usl = self._cur_spec
        wynik = "OK" if (lsl <= v <= usl) else "NOK"
        odch = v - nom
        zapas = min(v - lsl, usl - v)

        # zapis bieżącej cechy do bufora (indeks liczymy tak jak w planie: 1..N)
        rec = {
            "timestamp": _now_str(),
            "nr_szt": str(self.nr_szt),
            "idx_cechy": self.idx + 1,
            "opis_cechy": self._cur_label,
            "wartosc": v,
            "odchylka": odch,
            "zapas": zapas,
            "wynik": wynik,
            "kto_mierzy": self.rola,
            "narzedzie": self._cur_narz,
            "nominal": nom, "lsl": lsl, "usl": usl,
        }
        # jeżeli wrócono „Wstecz” i nadpisujemy ten krok
        if len(self.rekordy) > self.idx:
            self.rekordy[self.idx] = rec
        else:
            self.rekordy.append(rec)
            
        if self.on_progress:
            try:
                self.on_progress({
                    "nr_szt": self.nr_szt,
                    "rola": self.rola,
                    "records": list(self.rekordy),
                })
            except Exception:
                pass


        if self.idx == len(self.cechy) - 1:
            # koniec – oddaj całą listę
            try:
                self.on_finish(self.rekordy)
            finally:
                self.destroy()
            return

        self.idx += 1
        self._show_step()

    def _back(self):
        if self.idx > 0:
            self.idx -= 1
            self._show_step()

    def _cancel(self):
        if messagebox.askyesno("Anuluj", "Przerwać bieżący pomiar tej sztuki?"):
            if self.on_cancel:
                try:
                    self.on_cancel()
                except Exception:
                    pass

            self.destroy()




