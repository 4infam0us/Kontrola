    def _plan_as_dict_for_measure(self):
        src = self.var_pom_src.get() if hasattr(self, "var_pom_src") else "current"
        if src == "file" and self.pom_plan_data:
            return self.pom_plan_data
        meta = {
            "nr_rysunku": self.ent_rys.get().strip(),
            "autor": self.cb_autor.get().strip(),
            "sprawdzil": self.cb_sprawdzil.get().strip(),
            "zatwierdzil": self.cb_zatwierdzil.get().strip(),
            "data": self.lbl_data.cget("text"),
            "czestotliwosc": self._zbierz_czest_global(),
            "plik_rysunku": self.rysunek_path,
            "rodzaje_kontroli": self._rodzaje_checked(),
        }
        return {"metadane": meta, "cechy": list(self.cechy)}

    def _fnum(self, x, d=0.0):
        try: return float(str(x).replace(",", "."))
        except Exception: return d

    def _specs_for_cecha(self, c):
        nom  = self._fnum(c.get("nominal",""), 0.0)
        lsl  = nom + self._fnum(c.get("tol_minus",""), 0.0)   # LSL = nom + tol_minus (np. -0.011)
        usl  = nom + self._fnum(c.get("tol_plus",""), 0.0)    # USL = nom + tol_plus
        return nom, lsl, usl

    def _cecha_label_i_zakres(self, c):
        typ=c.get("typ",""); opis=c.get("opis",""); nom_s=c.get("nominal",""); jedn=c.get("jednostka","")
        nom, lsl, usl = self._specs_for_cecha(c)
        return f"{typ}: {opis}", f"{nom_s} {jedn}".strip(), lsl, usl, nom

