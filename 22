    def znajdz_rysunek_po_numerze(self):
        nr = self.ent_rys.get().strip()
        if not nr:
            messagebox.showinfo("Rysunek", "Podaj najpierw numer rysunku."); return
        if not os.path.isdir(self.folder_rysunkow):
            messagebox.showwarning("Folder rysunków", f"Folder nie istnieje:\n{self.folder_rysunkow}"); return
        wzorce = [f"*{nr}*.pdf", f"*{nr}*.PDF", f"*{nr}*.png", f"*{nr}*.jpg", f"*{nr}*.jpeg"]
        matches=[]
        for wz in wzorce: matches.extend(glob.glob(os.path.join(self.folder_rysunkow, wz)))
        def priority(p):
            ext = os.path.splitext(p)[1].lower()
            return 0 if ext==".pdf" else (1 if ext==".png" else 2)
        matches = sorted(set(matches), key=priority)
        if not matches:
            messagebox.showinfo("Rysunek", f"Nie znaleziono plików dla: {nr}\nFolder:\n{self.folder_rysunkow}"); return
        self.rysunek_path = matches[0]; self.lbl_rys_path.config(text=self.rysunek_path)

