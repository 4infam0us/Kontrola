    def eksport_do_word(self):
        save_path = None
        # --- wybór szablonu ---
        szablon_path = filedialog.askopenfilename(
            title="Wybierz szablon PKJ (Word z placeholderami)",
            filetypes=[("Dokument Word", "*.docx")]
        )
        if not szablon_path:
            return

        # 1) Otwórz szablon (NIE zapisujemy go nigdzie!)
        try:
            doc = Document(szablon_path)
        except Exception as e:
            messagebox.showerror("Błąd", f"Nie udało się otworzyć szablonu:\n{e}")
            return

        # --- dane z GUI ---
        nr_rys = self.ent_rys.get().strip()
        autor = self.cb_autor.get().strip()
        sprawdzil = self.cb_sprawdzil.get().strip()
        zatwierdzil = self.cb_zatwierdzil.get().strip()
        data_planu = self.lbl_data.cget("text")
        rodzaje = []
        if hasattr(self, "var_k_dost") and self.var_k_dost.get(): rodzaje.append("Z dostawy")
        if hasattr(self, "var_k_prod") and self.var_k_prod.get(): rodzaje.append("W trakcie produkcji")
        if hasattr(self, "var_k_konc") and self.var_k_konc.get(): rodzaje.append("Kontrola końcowa")
        rodzaje_str = ", ".join(rodzaje)

        # --- style dla wstawianych wartości (tylko to co podmieniamy) ---
        from docx.shared import Pt
        FONT_DEFAULT = ("Calibri", Pt(8), False, False)
        FONT_MAP = {
            "LP": ("Calibri", Pt(8), True, False),
            "TRESC": ("Consolas", Pt(8), False, False),
            "WYKONAWCA": ("Calibri", Pt(8), False, False),
            "CZESTOTLIWOSC": ("Calibri", Pt(8), False, False),
            "NARZEDZIE": ("Arial Narrow", Pt(8), False, False),
            "KRYTERIA": ("Calibri", Pt(8), False, True),
            "UWAGI": ("Calibri", Pt(8), False, False),
            "NR_RYS": ("Calibri", Pt(9), True, False),
            "AUTOR": ("Calibri", Pt(9), False, False),
            "SPRAWDZIL": ("Calibri", Pt(9), False, False),
            "ZATWIERDZIL": ("Calibri", Pt(9), False, False),
            "DATA_PLANU": ("Calibri", Pt(9), False, False),
            "RODZAJE_KONTROLI": ("Calibri", Pt(9), False, False),
        }

        def _f(x, default=0.0):
            try:
                return float(str(x).replace(",", "."))
            except Exception:
                return default

        # ---------- Funkcje pomocnicze: delikatna podmiana tekstu w runach ----------
        def _clone_run_format(dst_run, src_run):
            # skopiuj podstawowe atrybuty formatowania z istniejącego runu
            try:
                dst_run.font.name  = src_run.font.name
                dst_run.font.size  = src_run.font.size
                dst_run.font.bold  = src_run.font.bold
                dst_run.font.italic= src_run.font.italic
                dst_run.font.color.rgb = getattr(src_run.font.color, "rgb", None)
            except Exception:
                pass

        def _apply_value_style(run, key):
            name, size, bold, italic = FONT_MAP.get(key, FONT_DEFAULT)
            run.font.name   = name
            run.font.size   = size
            run.font.bold   = bold
            run.font.italic = italic

        def _replace_token_in_paragraph(par, token, value, style_key):
            """
            Podmień 'token' w akapicie 'par' na 'value' zachowując formatowanie otoczenia.
            Jeśli token mieści się w jednym runie – dzielimy go na before|value|after.
            Jeśli token przecina kilka runów – łączymy te runy logicznie i odtwarzamy minimalnie.
            Zwraca True, jeśli coś podmieniono.
            """
            runs = par.runs
            if not runs:
                return False

            # 1) Spróbuj znaleźć token w pojedynczym runie (najbezpieczniej)
            for i, r in enumerate(runs):
                txt = r.text
                idx = txt.find(token)
                if idx != -1:
                    before = txt[:idx]
                    after  = txt[idx + len(token):]
                    # nadpisz bieżący run na 'before'
                    r.text = before

                    # wstaw run dla wartości (z formatem jak wstawiana wartość)
                    val_run = par.add_run(value)
                    _clone_run_format(val_run, r)
                    _apply_value_style(val_run, style_key)

                    # wstaw run 'after'
                    after_run = None
                    if after:
                        after_run = par.add_run(after)
                        _clone_run_format(after_run, r)
                    # przesuń nowe runy bezpośrednio za częścią "before"
                    ref_el = r._element
                    val_el = val_run._element
                    ref_el.addnext(val_el)
                    if after_run is not None:
                        val_el.addnext(after_run._element)
                        
                    return True

            # 2) Token rozbity między runy – zbuduj bufor i znajdź pozycję
            full = "".join(r.text for r in runs)
            pos = full.find(token)
            if pos == -1:
                return False

            # tekst przed/po tokenie
            before = full[:pos]
            after  = full[pos + len(token):]

            # wyczyść wszystkie runy i odbuduj 3 odcinki: before | value | after
            for r in runs:
                r.text = ""
            # a) before – zachowaj format pierwszego istniejącego runu
            if before:
                r0 = par.runs[0] if par.runs else par.add_run()
                r0.text = before
                # nic nie zmieniamy w formatowaniu (pozostaje z szablonu)

            # b) value – nowy run ze stylem tylko dla wartości
            v_run = par.add_run(value)
            # staraj się skopiować format z sąsiada (jeśli before było puste, weź pierwszy run)
            ref = par.runs[0] if par.runs else v_run
            _clone_run_format(v_run, ref)
            _apply_value_style(v_run, style_key)

            # c) after – zachowaj format ostatniego runu z oryginału (jeśli był)
            if after:
                a_run = par.add_run(after)
                _clone_run_format(a_run, runs[-1])

            return True

        def _replace_token_in_cell(cell, token, value, style_key):
            """Podmień token w DOWOLNYM akapicie komórki (pierwsze trafienie)."""
            for par in cell.paragraphs:
                if _replace_token_in_paragraph(par, token, value, style_key):
                    return True
            return False

        def _replace_map_in_paragraph(par, mapping):
            changed = False
            # próbuj każdy token osobno (ważne przy wielu placeholderach w jednym akapicie)
            for token, (val, key) in mapping.items():
                # powtarzaj aż znikną wszystkie wystąpienia w tym paragrafie
                while True:
                    # szybkie sprawdzenie:
                    if token not in "".join(r.text for r in par.runs):
                        break
                    if _replace_token_in_paragraph(par, token, val, key):
                        changed = True
                    else:
                        break
            return changed

        def _replace_map_in_cell(cell, mapping):
            for par in cell.paragraphs:
                _replace_map_in_paragraph(par, mapping)

        # ---------- 1) Nagłówki ----------
        hdr_map = {
            "{{NR_RYS}}": (nr_rys, "NR_RYS"),
            "{{AUTOR}}": (autor, "AUTOR"),
            "{{SPRAWDZIL}}": (sprawdzil, "SPRAWDZIL"),
            "{{ZATWIERDZIL}}": (zatwierdzil, "ZATWIERDZIL"),
            "{{DATA_PLANU}}": (data_planu, "DATA_PLANU"),
            "{{RODZAJE_KONTROLI}}": (rodzaje_str, "RODZAJE_KONTROLI"),
        }
        # podmień w akapitach poza tabelami
        for p in doc.paragraphs:
            _replace_map_in_paragraph(p, hdr_map)
        # i w tabelach (gdy nagłówki są w ramkach/tabelkach)
        for t in doc.tables:
            for row in t.rows:
                for cell in row.cells:
                    _replace_map_in_cell(cell, hdr_map)

        # ---------- 2) Tabela PKJ: znajdź wiersz-szablon ----------
        TOKENS = ["{{LP}}", "{{TRESC}}", "{{WYKONAWCA}}", "{{CZESTOTLIWOSC}}",
                  "{{NARZEDZIE}}", "{{KRYTERIA}}", "{{UWAGI}}"]
        template_row = None
        template_table = None
        for t in doc.tables:
            for r in t.rows:
                texts = [c.text or "" for c in r.cells]
                if any(any(tok in txt for tok in TOKENS) for txt in texts):
                    template_row = r
                    template_table = t
                    break
            if template_row:
                break
        if not template_row:
            messagebox.showerror("Szablon", "Nie znaleziono wiersza-szablonu z placeholderami ({{LP}}, {{TRESC}}, ...).")
            return

        def row_index_by_tr(table, tr):
            for i, r in enumerate(table.rows):
                if r._tr is tr:
                    return i
            return None

        insert_pos = row_index_by_tr(template_table, template_row._tr)
        if insert_pos is None:
            messagebox.showerror("Szablon", "Nie udało się określić pozycji wiersza-szablonu.")
            return

        # ---------- 3) Wstaw dane cech (klon wiersza + delikatna podmiana tokenów w komórkach) ----------
        lp = 1
        for cecha in self.cechy:
            typ       = cecha.get("typ", "")
            opis      = cecha.get("opis", "")
            nom       = cecha.get("nominal", "")
            jedn      = cecha.get("jednostka", "")
            tol_minus = cecha.get("tol_minus", "")
            tol_plus  = cecha.get("tol_plus", "")
            kto       = cecha.get("kto_mierzy", "")
            narz      = cecha.get("narzedzie", "")
            czest     = cecha.get("czest_cechy") or self._zbierz_czest_global()
            if czest.startswith("Inne") and cecha.get("czest_cechy_inne"):
                czest = f"Inne: {cecha.get('czest_cechy_inne','')}"

            nom_f = _f(nom, 0.0)
            tmin  = _f(tol_minus, 0.0)
            tplus = _f(tol_plus, 0.0)
            min_ok = nom_f + tmin
            max_ok = nom_f + tplus
            tresc = f"{typ}: {opis}\nNominal: {nom} {jedn}\nTolerancje: {tol_minus} / {tol_plus}"
            kryteria = (f"OK jeśli {nom} {jedn} ∈ [{min_ok:.3f}; {max_ok:.3f}]" if jedn
                        else f"OK jeśli {nom} ∈ [{min_ok:.3f}; {max_ok:.3f}]")

            # klonuj wiersz i wstaw
            new_tr = deepcopy(template_row._tr)
            last_tr = template_table.rows[insert_pos]._tr
            last_tr.addnext(new_tr)

            new_row = None
            for r in template_table.rows:
                if r._tr is new_tr:
                    new_row = r
                    break

            mapping = {
                "{{LP}}": (str(lp), "LP"),
                "{{TRESC}}": (tresc, "TRESC"),
                "{{WYKONAWCA}}": (kto, "WYKONAWCA"),
                "{{CZESTOTLIWOSC}}": (czest, "CZESTOTLIWOSC"),
                "{{NARZEDZIE}}": (narz, "NARZEDZIE"),
                "{{KRYTERIA}}": (kryteria, "KRYTERIA"),
                "{{UWAGI}}": ("", "UWAGI"),
            }

            # podmieniaj tokeny w KAŻDEJ komórce – ale tylko wewnątrz runów zawierających token
            for cell in new_row.cells:
                _replace_map_in_cell(cell, mapping)

            insert_pos = row_index_by_tr(template_table, new_tr) or insert_pos + 1
            lp += 1

        # usuń wiersz-szablon (z tokenami)
        try:
            template_table._tbl.remove(template_row._tr)
        except Exception:
            pass

        # --- zapis ---
        save_path = filedialog.asksaveasfilename(
            title="Zapisz plan kontroli (Word)",
            initialfile=f"PlanKontroli_{nr_rys}_{data_planu}.docx",
            defaultextension=".docx",
            filetypes=[("Dokument Word", "*.docx")]
        )
        if not save_path:
            return
        try:
            doc.save(save_path)
        except Exception as e:
            messagebox.showerror("Błąd zapisu", f"Nie udało się zapisać DOCX:\n{e}")
            return
        messagebox.showinfo("Zapisano", f"Utworzono dokument:\n{save_path}")
            # 7) PDF tylko z gotowego DOCX
        if save_path and os.path.isfile(save_path):
            try:
                pdf_target = os.path.splitext(save_path)[0] + ".pdf"
                out_pdf = self._docx_to_pdf(save_path, pdf_target)
                if out_pdf and os.path.exists(out_pdf):
                    messagebox.showinfo(
                        "Zapisano",
                        f"Utworzono:\n{save_path}\n\noraz PDF:\n{out_pdf}"
                        )
                else:
                    messagebox.showwarning(
                            "PDF",
                            "Word zapisano, ale PDF nie powstał automatycznie.\n"
                            "Zainstaluj docx2pdf (pip install docx2pdf) lub użyj MS Word (COM)."
                    )
            except Exception as e:
                messagebox.showwarning("PDF", f"PDF nie został utworzony:\n{e}")            


    def _docx_to_pdf(self, docx_path, pdf_path):
        """
        Konwertuje plik DOCX na PDF.
        Najpierw próbuje przez bibliotekę docx2pdf, jeśli nie działa — zwraca None.
        """
        import os
        try:
            from docx2pdf import convert
            convert(docx_path, pdf_path)
            if os.path.exists(pdf_path):
                return pdf_path
        except ImportError:
            # docx2pdf nie jest zainstalowany
            return None
        except Exception:
            # np. brak MS Word / COM / błąd dostępu
            return None
        return None


