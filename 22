    def _maximize_window(self):
        """Start w trybie zmaksymalizowanym + bezpieczne minima zależne od ekranu."""
        try:
            sw = self.winfo_screenwidth()
            sh = self.winfo_screenheight()
        except Exception:
            sw, sh = 1280, 800

        # Sensowne minima (70% ekranu, ale nie mniej niż 1024x700)
        min_w = max(1024, int(sw * 0.70))
        min_h = max(700,  int(sh * 0.70))
        self.minsize(min_w, min_h)

        # Próba natywnego „maximized”
        try:
            if sys.platform.startswith("win"):
                # Windows – szybkie i pewne
                self.state("zoomed")
            elif sys.platform == "darwin":
                # macOS – różnie bywa; najpierw zoomed, potem pełny rozmiar okna roboczego
                self.attributes("-zoomed", True)
                self.geometry(f"{sw}x{sh}+0+0")
            else:
                # Linux/pozostałe – często działa -zoomed, jeśli nie, to pełny rozmiar
                try:
                    self.attributes("-zoomed", True)
                except Exception:
                    self.geometry(f"{sw}x{sh}+0+0")
        except Exception:
            # Fallback, gdyby powyższe się nie udało
            self.geometry(f"{sw}x{sh}+0+0")

        # Skrót F11: przełączanie pełnego ekranu (przydatne na małych ekranach)
        self.bind("<F11>", self._toggle_fullscreen)
        self.bind("<Escape>", self._exit_fullscreen)
        
    def _on_tab_changed(self, event=None):
        try:
            current = self.nb.nametowidget(self.nb.select())
        except Exception:
            return
        if current in self._protected_tabs:
            if not self._ensure_tab_access(current):
                self.nb.select(self._last_tab)
                return
        self._last_tab = current

    def _ensure_tab_access(self, tab):
        if self._tab_access.get(tab):
            return True
        if not self.password_hash:
            self._tab_access[tab] = True
            return True
        label = self._protected_tabs.get(tab, "zakładki")
        pw = simpledialog.askstring("Hasło", f"Podaj hasło do zakładki: {label}", show="*")
        if pw is None:
            return False
        if _verify_password(pw, self.password_hash):
            self._tab_access[tab] = True
            return True
        messagebox.showerror("Hasło", "Nieprawidłowe hasło.")
        return False



    def _toggle_fullscreen(self, event=None):
        fs = bool(self.attributes("-fullscreen"))
        self.attributes("-fullscreen", not fs)

    def _exit_fullscreen(self, event=None):
        if bool(self.attributes("-fullscreen")):
            self.attributes("-fullscreen", False)
            
    def ustaw_haslo_zakladek(self):
        master_pw = simpledialog.askstring("Hasło nadrzędne", "Podaj hasło nadrzędne:", show="*")
        if master_pw is None:
            return
        if not _verify_password(master_pw, MASTER_TAB_PASSWORD_HASH):
            messagebox.showerror("Hasło", "Nieprawidłowe hasło nadrzędne.")
            return
        new_pw = simpledialog.askstring("Hasło", "Ustaw nowe hasło (puste = usuń):", show="*")
        if new_pw is None:
            return
        if new_pw:
            confirm = simpledialog.askstring("Hasło", "Powtórz nowe hasło:", show="*")
            if confirm is None:
                return
            if new_pw != confirm:
                messagebox.showwarning("Hasło", "Hasła nie są zgodne.")
                return
            self.password_hash = _hash_password(new_pw)
        else:
            self.password_hash = ""
        for tab in self._protected_tabs:
            self._tab_access[tab] = False
        self._persist_config()



    # ===== Obsługa współdzielonego folderu danych =====
    def _persist_config(self):
        self.stanowisko_id = self.var_stanowisko_id.get().strip() or socket.gethostname()
        self.var_stanowisko_id.set(self.stanowisko_id)
        self._update_folder_danych_label()
        zapisz_konfiguracje(
            self.narzedzia,
            self.autorzy,
            self.katalog_bazowy,
            self.folder_rysunkow,
            self.tolerancje,
            self.folder_danych,
            self.stanowisko_id,
            self.password_hash,
        )

    def _update_folder_danych_label(self):
        path = (self.folder_danych or "").strip()
        if path and os.path.isdir(path):
            display = path
        else:
            display = path or "(nie ustawiono)"
        self.folder_danych_var.set(display)

    def ustaw_folder_danych(self):
        path = filedialog.askdirectory(title="Wybierz współdzielony folder danych", initialdir=self.folder_danych or self.katalog_bazowy)
        if not path:
            return
        self.folder_danych = path
        self._update_folder_danych_label()
        self._persist_config()
        self._sync_shared_state()

    def otworz_folder_danych(self):
        path = (self.folder_danych or "").strip()
        if not path:
            messagebox.showinfo("Folder danych", "Nie ustawiono jeszcze folderu z danymi.")
            return
        if not os.path.isdir(path):
            messagebox.showwarning("Folder danych", f"Folder nie istnieje:\n{path}")
            return
        _open_file_native(path)

    def _history_folder(self):
        base = (self.folder_danych or "").strip()
        folder = SHARED_HISTORY_FOLDER if not base else os.path.join(base, "historia_pomiarow")
        if not folder:
            return ""
        base_dir = os.path.dirname(folder)
        try:
            if base_dir:
                os.makedirs(base_dir, exist_ok=True)
            os.makedirs(folder, exist_ok=True)
        except Exception:
            return ""
        return folder


    def _history_daily_path(self, date_str=None):
        folder = self._history_folder()
        if not folder:
            return ""
        day = date_str or datetime.date.today().isoformat()
        return os.path.join(folder, f"Historia_Pomiarow_{day}.csv")

    def _queue_history_records(self, records):
        if not records:
            return
        self._history_queue.extend(records)
        if not self._history_flush_scheduled:
            self._history_flush_scheduled = True
            self.after(300, self._flush_history_queue)

    def _flush_history_queue(self):
        self._history_flush_scheduled = False
        if not self._history_queue:
            return
        records = list(self._history_queue)
        self._history_queue.clear()
        path = self._history_daily_path()
        if not path:
            if not self._history_warned:
                messagebox.showwarning("Historia pomiarów", "Nie można zapisać historii pomiarów (brak folderu docelowego).")
                self._history_warned = True
            self._history_queue.extend(records)
            return
        if not self.folder_danych and not self._history_warned:
            messagebox.showwarning(
