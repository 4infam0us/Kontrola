    def _shared_state_path(self):
        path = (self.folder_danych or "").strip() or SHARED_DATA_FOLDER
        if not path:
            return ""
        safe_name = re.sub(r"[^0-9A-Za-z._-]+", "_", self.stanowisko_id).strip("._-") or "stanowisko"
        return os.path.join(path, f"{safe_name}.json")

    def _local_in_progress_path(self):
        base = os.getcwd()
        return os.path.join(base, LOCAL_PROGRESS_FILE)

    def _shared_state_payload(self):
        plan = self._plan_as_dict_for_measure()
        meta = plan.get("metadane", {})
        source = self.var_pom_src.get().strip() if hasattr(self, "var_pom_src") else "current"
        payload = {
            "machine_id": self.stanowisko_id,
            "updated_at": _now_str(),
            "plan_meta": meta,
            "plan_source": source,
            "plan_file": self.pom_plan_path if source == "file" else "",
            "role": self.var_pom_rola.get().strip() if hasattr(self, "var_pom_rola") else "",
            "measurements": list(self.pomiary),
            "in_progress": self._pom_in_progress,
        }
        return payload

    def _sync_shared_state(self):
        path = self._shared_state_path()
        if not path:
            return
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            payload = self._shared_state_payload()
            tmp_path = f"{path}.tmp"
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(payload, f, ensure_ascii=False, indent=2)
            os.replace(tmp_path, path)
        except Exception as exc:
            print(f"[WARN] Nie udało się zapisać stanu pomiarów do folderu danych: {exc}")
            
    def _load_shared_state_for_self(self):
        path = self._shared_state_path()
        if not path or not os.path.isfile(path):
            return {}
        try:
            data = _load_json(path)
            return data if isinstance(data, dict) else {}
        except Exception:
            return {}

    def _restore_in_progress(self):
        state = self._load_shared_state_for_self()
        in_progress = state.get("in_progress")
        if isinstance(in_progress, dict):
            return in_progress
        local_path = self._local_in_progress_path()
        if os.path.isfile(local_path):
            try:
                data = _load_json(local_path)
                return data if isinstance(data, dict) else None
            except Exception:
                return None
        return None

    def _set_in_progress(self, data):
        self._pom_in_progress = data
        local_path = self._local_in_progress_path()
        if data:
            try:
                tmp_path = f"{local_path}.tmp"
                with open(tmp_path, "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
                os.replace(tmp_path, local_path)
            except Exception:
                pass
        else:
            try:
                if os.path.isfile(local_path):
                    os.remove(local_path)
            except Exception:
                pass
        self._sync_shared_state()

    def _load_shared_states(self):
        path = (self.folder_danych or "").strip()
        if not path or not os.path.isdir(path):
            return []
        results = []
        for fn in glob.glob(os.path.join(path, "*.json")):
            if os.path.basename(fn).lower() == KONFIG_PLIK.lower():
                continue
            try:
                data = _load_json(fn)
                if isinstance(data, dict):
                    data["__file"] = fn
                    results.append(data)
            except Exception:
                continue
        return results


