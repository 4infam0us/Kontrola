        btns = ttk.Frame(frm); btns.grid(row=5, column=0, columnspan=2, sticky="e", pady=(12,0))
        ttk.Button(btns, text="Anuluj", command=dlg.destroy).grid(row=0, column=0, padx=6)
        ttk.Button(btns, text="Zapisz", command=accept).grid(row=0, column=1)

        ent_val.focus_set()


