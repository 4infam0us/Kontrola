    def oblicz_cp_cpk(self):
        plan = self._plan_as_dict_for_measure(); cechy = plan.get("cechy", [])
        wybr = self.cb_cap_cecha.get().strip()
        if not wybr:
            messagebox.showinfo("Cp/Cpk","Wybierz cechę."); return
        try: idx = int(wybr.split(".",1)[0]) - 1
        except Exception: messagebox.showinfo("Cp/Cpk","Niepoprawny wybór cechy."); return
        if not (0 <= idx < len(cechy)):
            messagebox.showinfo("Cp/Cpk","Poza zakresem."); return

        c = cechy[idx]
        nom, lsl, usl = self._specs_for_cecha(c)

        # zbierz wartości tylko dla tej cechy
        vals = [r["wartosc"] for r in self.pomiary if r.get("idx_cechy")==idx+1]
        result = _calculate_capability(vals, lsl, usl)
        if result.error:
            self.lbl_cap_wynik.config(text=f"(n={result.n})  {result.error}")
            return

        

        self.lbl_cap_wynik.config(
            text=(
                f"(n={result.n})  Cp: {result.cp:.3f}   Cpk: {result.cpk:.3f}   ȳ: {result.mean:.6f}   "
                f"s: {result.sigma:.6f}   LSL/USL: {lsl:.6f}/{usl:.6f}"
            )
        )

    def _safe_key(self, s: str) -> str:
        # klucz do porównań nazw plików
        return (s or "").strip().replace("/", "-").replace("\\", "-").replace(" ", "_").lower()

    def _open_pkj_auto(self):
        """Otwórz PDF planu pomiarowego (PKJ)"""
        plan = self._plan_as_dict_for_measure()
        nr_rys = (plan.get("metadane", {}) or {}).get("nr_rysunku", "") or ""
        if not nr_rys:
            nr_rys = (self.ent_rys.get() or "").strip()
        if not nr_rys:
            return

        key = self._safe_key(nr_rys)

        # Gdzie szukamy: katalog pliku planu + katalog bazowy
        candidates_dirs = []
        if getattr(self, "pom_plan_path", ""):
            candidates_dirs.append(os.path.dirname(self.pom_plan_path))
        if self.katalog_bazowy and self.katalog_bazowy not in candidates_dirs:
            candidates_dirs.append(self.katalog_bazowy)

        # 1) Najpierw spróbuj dokładny wzorzec: PlanKontroli_{nr}.pdf
        exact_names = [
            f"PlanKontroli_{self._safe_key(nr_rys)}.pdf",
            f"plankontroli_{self._safe_key(nr_rys)}.pdf",
        ]
        for d in candidates_dirs:
            for nm in exact_names:
                p = os.path.join(d, nm)
                if os.path.isfile(p):
                    _open_file_native(p)
                    return

        # 2) Potem dowolny PlanKontroli_*.pdf zawierający numer rysunku (najświeższy)
        best_pkj, best_pkj_mtime = None, -1
        for d in candidates_dirs:
            if not d or not os.path.isdir(d):
                continue
            try:
                for fn in os.listdir(d):
                    fl = fn.lower()
                    if not fl.endswith(".pdf"):
                        continue
                    if not fl.startswith("plankontroli_"):
                        continue
                    if key not in fl:
                        continue
                    path = os.path.join(d, fn)
                    mt = os.path.getmtime(path)
                    if mt > best_pkj_mtime:
                        best_pkj_mtime = mt
                        best_pkj = path
            except Exception:
                pass
        if best_pkj:
            _open_file_native(best_pkj)
            return

        # 3) Na końcu: dowolny PDF z numerem rysunku, ale filtrujemy raporty
        NEG = ("raport", "wynik", "sprawozd")
        best_any, best_any_mtime = None, -1
        for d in candidates_dirs:
            if not d or not os.path.isdir(d):
                continue
            try:
                for fn in os.listdir(d):
                    fl = fn.lower()
                    if not fl.endswith(".pdf"):
                        continue
                    if key not in fl:
                        continue
                    if any(bad in fl for bad in NEG):
                        continue  # odrzucamy raporty/wyniki
                    path = os.path.join(d, fn)
                    mt = os.path.getmtime(path)
                    if mt > best_any_mtime:
                        best_any_mtime = mt
                        best_any = path
            except Exception:
                pass
        if best_any:
            _open_file_native(best_any)
            return
        # Nic nie znaleziono – po prostu nic nie otwieramy (bez komunikatu).
   
    def wydzial_odswiez(self):
        for i in self.tv_wydzial.get_children():
            self.tv_wydzial.delete(i)

        folder = (self.folder_danych or "").strip()
        if not folder:
            self.tv_wydzial.insert("", "end", values=(
                "Brak skonfigurowanego folderu danych",
                "",
                "",
                "",
                "",
                "",
                "",
                "",
            ))
            return

        if not os.path.isdir(folder):
            self.tv_wydzial.insert("", "end", values=(
                f"Folder nie istnieje: {folder}",
                "",
                "",
                "",
                "",
                "",
                "",
                "",
            ))
            return

        states = self._load_shared_states()
        if not states:
            self.tv_wydzial.insert("", "end", values=(
                "Brak plików *.json w folderze danych",
                "",
                "",
                "",
                "",
                "",
                "",
                "",
            ))
            return

        def plan_label(meta):
            nr = (meta.get("nr_rysunku") or "").strip()
            autor = (meta.get("autor") or "").strip()
            data = (meta.get("data") or "").strip()
            pieces = [p for p in (nr, autor) if p]
            text = " – ".join(pieces) if pieces else nr or autor
            if data:
                text = f"{text} ({data})" if text else f"({data})"
            return text or "(brak)"

        for entry in sorted(states, key=lambda d: (d.get("machine_id") or "").lower()):
            machine = entry.get("machine_id") or os.path.splitext(os.path.basename(entry.get("__file", "")))[0]
            meta = entry.get("plan_meta") or {}
            plan_txt = plan_label(meta)
            role = entry.get("role") or ""
            pomiary = entry.get("measurements") or []
            count = len(pomiary)
            if not pomiary:
                self.tv_wydzial.insert(
                    "",
                    "end",
                    values=(
                        machine,
                        plan_txt,
                        role,
                        "",
                        "",
                        "",
                        "0",
                        entry.get("updated_at", ""),
                    ),
                )
                continue

            for rec in pomiary:
                idx = rec.get("idx_cechy")
                label = rec.get("opis_cechy", "")

                if idx:
                    cecha = f"{idx}. {label}" if label else str(idx)
                else:
                    cecha = label
                wartosc = rec.get("wartosc")
                if isinstance(wartosc, (int, float)):
                    wartosc_txt = f"{wartosc:.6f}"
                else:
                    wartosc_txt = wartosc or ""
                wynik = rec.get("wynik", "")
                updated = rec.get("timestamp", "") or entry.get("updated_at", "")
                role_txt = rec.get("kto_mierzy", "") or role
                tags = ("nok",) if str(wynik).upper() == "NOK" else ()
                self.tv_wydzial.insert(
                    "",
                    "end",
                    values=(
                        machine,
                        plan_txt,
                        role_txt,
                        cecha,
                        wartosc_txt,
                        wynik,
                        str(count),
                        updated,
                    ),
                    tags=tags,
                )



    def wydzial_toggle_auto(self):
        if self.auto_refresh.get():
            self.after(0, self._wydzial_auto_loop)

    def _wydzial_auto_loop(self):
        if not self.auto_refresh.get():
            return
        self.wydzial_odswiez()
        # ponów co 15 sekund
        self.after(15000, self._wydzial_auto_loop)




