            return
        self.ent_jedn.delete(0, tk.END)
        self.ent_jedn.insert(0, unit)
        self._last_autofill_unit = unit
        

    def _apply_norm(self, auto=False):
        if not self.var_use_norm.get():
            if not auto: messagebox.showinfo("Norma", "Zaznacz „Użyj tolerancji wg normy…”.")
            return
        try:
            nominal = float(str(self.ent_nom.get()).replace(",", "."))
        except Exception:
            if not auto: messagebox.showwarning("Nominal", "Podaj poprawną wartość nominalną [mm].")
            return
        symbol = self.cb_symbol.get().strip()
        if not symbol:
            if not auto: messagebox.showwarning("Symbol", "Wybierz symbol (np. H7, ISO2768-m).")
            return
        # znajdź wpis tolerancji
        t = None
        for rec in self.tolerancje:
            if rec.get("symbol","") == symbol and rec.get("d_min",0) < nominal <= rec.get("d_max",0):
                t = rec; break
        if not t:
            if not auto: messagebox.showwarning("Brak wpisu", "Nie ma wpisu dla tego symbolu i zakresu.")
            return
        ES_mm = t.get("ES_um",0) / 1000.0
        EI_mm = t.get("EI_um",0) / 1000.0
        self.ent_tol_minus.delete(0, tk.END); self.ent_tol_minus.insert(0, f"{EI_mm:.6f}".rstrip("0").rstrip("."))
        self.ent_tol_plus.delete(0, tk.END); self.ent_tol_plus.insert(0, f"{ES_mm:.6f}".rstrip("0").rstrip("."))

    def _zbierz_czest(self):
        wyb = self.cb_czest_cechy.get().strip()
        if wyb.startswith("Inne"):
            txt = self.ent_czest_inne.get().strip()
            return (wyb, txt)
        return (wyb, "")

    def _accept(self):
        czest_label, czest_inne = self._zbierz_czest()
        dane = {
            "typ": self.cb_typ.get().strip(),
            "opis": self.ent_opis.get().strip(),
            "nominal": self.ent_nom.get().strip(),
            "tol_minus": self.ent_tol_minus.get().strip(),
            "tol_plus": self.ent_tol_plus.get().strip(),
            "jednostka": self.ent_jedn.get().strip(),
            "narzedzie": self.cb_narzedzie.get().strip(),
            "kto_mierzy": self.cb_kto.get().strip(),
            "czest_cechy": czest_label,
            "czest_cechy_inne": czest_inne,
        }
        if not dane["typ"] or not dane["opis"]:
            messagebox.showwarning("Brak danych", "Uzupełnij co najmniej: Typ cechy oraz Opis.")
            return
        self.on_accept(dane); self.destroy()

