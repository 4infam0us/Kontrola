        ttk.Label(ed, text="Nazwa / opis:").grid(row=0, column=0, sticky="e"); self.ent_name = ttk.Entry(ed, width=50)
        self.ent_name.grid(row=0, column=1, sticky="w", padx=6, pady=2)
        ttk.Label(ed, text="Ostatnie wzorcowanie (YYYY-MM-DD):").grid(row=1, column=0, sticky="e"); self.ent_last = ttk.Entry(ed, width=20)
        self.ent_last.grid(row=1, column=1, sticky="w", padx=6, pady=2)
