    def _recalc_for_record(self, rec):
        """Przelicza po zmianie wartości: odchyłkę, zapas, wynik (OK/NOK)."""
        val = rec["wartosc"]
        nom = rec["nominal"]; lsl = rec["lsl"]; usl = rec["usl"]
        if lsl > usl: lsl, usl = usl, lsl
        rec["odchylka"] = val - nom
        rec["zapas"] = min(val - lsl, usl - val)
        rec["wynik"] = "OK" if (lsl <= val <= usl) else "NOK"

    def pom_edytuj_zaznaczony(self):
