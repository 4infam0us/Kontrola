    def generuj_raport_pomiarowy(self, path_pdf):
        import statistics
        import numpy as np
        import matplotlib.pyplot as plt
        from reportlab.lib.pagesizes import A4
        from reportlab.pdfgen import canvas
        from reportlab.lib.units import cm

        if not self.pomiary:
            messagebox.showwarning("Raport", "Brak pomiarów do raportu.")
            return
        
        reg_font, bold_font = self._register_pl_font()
        plan = self._plan_as_dict_for_measure()
        meta = plan.get("metadane", {})
        nr_rys = meta.get("nr_rysunku", "")
        autor = meta.get("autor", "")
        #sprawdzil = meta.get("sprawdzil", "")
        #zatwierdzil = meta.get("zatwierdzil", "")
        data = meta.get("data", "")

        # 1) zgrupuj pomiary wg ID cechy (stabilniej niż po etykiecie)
        by_idx = {}
        for r in self.pomiary:
            by_idx.setdefault(r["idx_cechy"], []).append(r)

        # 2) przygotuj PDF
        c = canvas.Canvas(path_pdf, pagesize=A4)
        W, H = A4
        top = H - 2*cm
        c.setFont(bold_font, 14)
        c.drawString(2*cm, top, f"Raport pomiarowy – {nr_rys}")
        c.setFont(reg_font, 10) 
        c.drawString(2*cm, top-0.8*cm, f"Autor planu: {autor}")
        #c.drawString(2*cm, top-1.3*cm, f"Sprawdził: {sprawdzil}")
        #c.drawString(2*cm, top-1.8*cm, f"Zatwierdził: {zatwierdzil}")
        c.drawString(2*cm, top-1.3*cm, f"Data planu: {data}")
        c.drawString(2*cm, top-1.8*cm, f"Utworzono: {_now_str()}")
        y = top - 3.6*cm

        for idx_cechy in sorted(by_idx.keys()):
            lst = by_idx[idx_cechy]
            # weź dane Z SAMEGO POMIARU (te, które zapisałeś do CSV):
            vals = [r["wartosc"] for r in lst]
            # jeśli w którymś rekordzie LSL/USL jest „odwrócony”, napraw:
            lsl = min(r["lsl"] if r["lsl"] <= r["usl"] else r["usl"] for r in lst)
            usl = max(r["usl"] if r["usl"] >= r["lsl"] else r["lsl"] for r in lst)
            label = lst[0]["opis_cechy"]

            result = _calculate_capability(vals, lsl, usl)
            n = result.n
            mean = result.mean
            sigma = result.sigma
            cp = result.cp
            cpk = result.cpk
            if result.n < 2:
                # wypisz krótką sekcję bez wykresu
                c.setFont(reg_font, 10) 
                if y < 6*cm: c.showPage(); y = H - 2*cm
                c.drawString(2*cm, y, f"{idx_cechy}. {label}")
                y -= 0.4*cm
                c.setFont(reg_font, 10) 
                c.drawString(2*cm, y, f"n={result.n}  {result.error}   LSL={lsl:.6f}  USL={usl:.6f}")
                y -= 0.8*cm
                continue


            # --- DIAGNOSTYKA do konsoli (pomaga przy weryfikacji) ---
            try:
                print(
                    f"[DEBUG] Cecha {idx_cechy}: {label} | n={result.n} mean={result.mean:.6f} "
                    f"sigma={result.sigma:.6f} LSL={lsl:.6f} USL={usl:.6f} Cp={result.cp:.3f} Cpk={result.cpk:.3f}"
                )
            except Exception:
                pass

            # 3) wykres: histogram (gęstość), PDF normalny, linie LSL/USL/mean/±3σ,
            #    zakres x = [min(min(vals), LSL), max(max(vals), USL)]
            x_min = min(min(vals), lsl)
            x_max = max(max(vals), usl)
            pad = 0.05 * (x_max - x_min or 1.0)
            x_min -= pad; x_max += pad

            fig, ax = plt.subplots(figsize=(6.5, 3.2))
            ax.hist(vals, bins=min(12, max(5, int(np.sqrt(result.n)))), density=True,
                    color="#A3C1DA", edgecolor="black", alpha=0.7)

            if result.sigma > 0:
                xs = np.linspace(x_min, x_max, 400)
                norm = (1/(result.sigma*np.sqrt(2*np.pi))) * np.exp(-0.5*((xs-result.mean)/sigma)**2)
                ax.plot(xs, norm, linewidth=2, label="N(ȳ, σ)", color="red")

            # pas tolerancji (LSL, USL)
            ax.axvspan(lsl, usl, color="#C4E6C3", alpha=0.3, label="Pole tolerancji")
            ax.axvline(lsl, color="black", linestyle="--", label=f"LSL {lsl:.3f}")
            ax.axvline(usl, color="black", linestyle="--", label=f"USL {usl:.3f}")
            ax.axvline(result.mean, color="red", linestyle="-", label=f"ȳ {result.mean:.3f}")

            if result.sigma > 0:
                ax.axvline(result.mean-3*result.sigma, color="gray", linestyle=":", linewidth=1, label="-3σ")
                ax.axvline(result.mean+3*result.sigma, color="gray", linestyle=":", linewidth=1, label="+3σ")

            ax.set_xlim(x_min, x_max)
            ax.set_title(f"{idx_cechy}. {label}")
            ax.set_xlabel("Wartości pomiarów")
            ax.set_ylabel("Gęstość")
            ax.grid(alpha=0.25)
            ax.legend(fontsize=7, ncol=3, loc="upper center")

            
            
            # Strona PDF – nagłówek + obraz + podpis Cp/Cpk
            
            fig.tight_layout()
            buffer = io.BytesIO()
            fig.savefig(buffer, format="png", dpi=150, bbox_inches="tight")
            buffer.seek(0)
            plt.close(fig)
            image = ImageReader(buffer)
            if y < 9*cm:
                c.showPage()
                y = H - 2*cm
            c.setFont(reg_font, 10) 
            c.drawString(2*cm, y, f"{idx_cechy}. {label}")
            y -= 0.4*cm
            c.setFont(reg_font, 10)
            c.drawString(
                2*cm,
                y,
                f"n={result.n}   ȳ={result.mean:.6f}   σ={result.sigma:.6f}   "
                f"LSL={lsl:.6f}   USL={usl:.6f}   Cp={result.cp:.3f}   Cpk={result.cpk:.3f}"
            )
            if result.error:
                y -= 0.4*cm
                c.drawString(2*cm, y, result.error)
            y -= 5.8*cm
            c.drawImage(image, 2*cm, y, width=16.5*cm, height=5.2*cm, preserveAspectRatio=True, anchor='sw')
            y -= 1.0*cm

        c.save()
        messagebox.showinfo("Raport", f"Zapisano raport PDF:\n{path_pdf}")



