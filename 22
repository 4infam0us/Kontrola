    def pom_start_pomiary(self):
        cechy_seq = self._list_cechy_dla_roli()
        if not cechy_seq:
            messagebox.showwarning("Pomiary", "Brak cech do pomiaru (sprawdź plan i/lub rolę).")
            return
        rola = self.var_pom_rola.get().strip() if hasattr(self, "var_pom_rola") else "Operator"
        nr = self._pom_nr_szt

        existing = self._restore_in_progress()
        if existing and existing.get("records"):
            if messagebox.askyesno(
                "Przywróć pomiary",
                "Wykryto zapisane pomiary w toku. Czy chcesz je kontynuować?",
            ):
                rola = existing.get("rola") or rola
                nr = existing.get("nr_szt") or nr
            else:
                self._set_in_progress(None)
                existing = None

        def on_finish(recs):
            # dopisz i zwiększ licznik sztuk
            self._append_measure_records(recs)
            self._pom_nr_szt += 1
            self._set_in_progress(None)

        def on_progress(payload):
            if payload:
                self._set_in_progress(payload)

        def on_cancel():
            self._set_in_progress(None)

        DialogProwadzonePomiary(
            self,
            cechy_seq,
            nr,
            rola,
            on_finish,
            on_progress=on_progress,
            on_cancel=on_cancel,
            existing=existing,
        )

        



    def _register_pl_font(self):
        """
        Rejestruje czcionki TrueType z polskimi znakami w ReportLab.
        Zwraca krotkę (regular_name, bold_name) do użycia z canvas.setFont(...).
        Próbujemy kilka popularnych ścieżek; jeśli nic nie znajdziemy, zostaje DejaVu z Matplotlib.
        """
        candidates = [
            # Windows
            (r"C:\Windows\Fonts\calibri.ttf", r"C:\Windows\Fonts\calibrib.ttf", "PL-Calibri", "PL-Calibri-Bold"),
            (r"C:\Windows\Fonts\arial.ttf",   r"C:\Windows\Fonts\arialbd.ttf", "PL-Arial",   "PL-Arial-Bold"),
            (r"C:\Windows\Fonts\segoeui.ttf", r"C:\Windows\Fonts\seguib.ttf",  "PL-Segoe",   "PL-Segoe-Bold"),
            # Linux (DejaVu)
            ("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
             "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", "PL-DejaVu", "PL-DejaVu-Bold"),
            # macOS (Helvetica Neue może nie mieć wszystkich znaków – spróbujemy Arial)
            ("/Library/Fonts/Arial.ttf", "/Library/Fonts/Arial Bold.ttf", "PL-Arial-Mac", "PL-Arial-Mac-Bold"),
        ]
        for reg_path, bold_path, reg_name, bold_name in candidates:
            try:
                if os.path.isfile(reg_path):
                    pdfmetrics.registerFont(TTFont(reg_name, reg_path))
                    if os.path.isfile(bold_path):
                        pdfmetrics.registerFont(TTFont(bold_name, bold_path))
                    else:
                        bold_name = reg_name
                    # Ustaw też Matplotlib na tę samą rodzinę (żeby legendy/titles miały polskie znaki)
                    try:
                        matplotlib.rcParams["font.family"] = reg_name
                    except Exception:
                        pass
                    return reg_name, bold_name
            except Exception:
                continue

        # awaryjnie: szukamy DejaVu z Matplotlib (zawsze jest w pakiecie)
        try:
            from matplotlib import font_manager
            dejavu_path = font_manager.findfont("DejaVu Sans")
            pdfmetrics.registerFont(TTFont("PL-DejaVuAuto", dejavu_path))
            matplotlib.rcParams["font.family"] = "DejaVu Sans"
            return "PL-DejaVuAuto", "PL-DejaVuAuto"
        except Exception:
            # Ostateczny fallback – może dalej brak PL znaków, ale unikamy crasha.
            return "Helvetica", "Helvetica"


