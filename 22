def _parse_date(s: str):
    s = (s or "").strip()
    if not s: return None
    try: return datetime.date.fromisoformat(s)
    except Exception: return None

def _today(): return datetime.date.today()

def _now_str():
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

def _hash_password(password, salt=None, iterations=200_000):
    if password is None:
        return ""
    pwd = password.encode("utf-8")
    if salt is None:
        salt = secrets.token_bytes(16)
    elif isinstance(salt, str):
        salt = base64.b64decode(salt.encode("utf-8"))
    dk = hashlib.pbkdf2_hmac("sha256", pwd, salt, iterations)
    return "pbkdf2$%d$%s$%s" % (
        iterations,
        base64.b64encode(salt).decode("utf-8"),
        base64.b64encode(dk).decode("utf-8"),
    )

def _verify_password(password, stored):
    if not stored:
        return True
    try:
        algo, it_s, salt_s, hash_s = stored.split("$", 3)
        if algo != "pbkdf2":
            return False
        candidate = _hash_password(password, salt=salt_s, iterations=int(it_s))
        return secrets.compare_digest(candidate, stored)
    except Exception:
        return False


def _open_file_native(path):
    try:
        if sys.platform.startswith("win"):
            os.startfile(path)  # type: ignore[attr-defined]
        elif sys.platform == "darwin":
            subprocess.Popen(["open", path])
        else:
            subprocess.Popen(["xdg-open", path])
    except Exception as e:
        messagebox.showerror("Podgląd rysunku", f"Nie udało się otworzyć pliku:\n{e}")
        
def _ensure_dir(path):
    if not path:
        return ""
    try:
        os.makedirs(path, exist_ok=True)
    except Exception:
        pass
    return path
    

