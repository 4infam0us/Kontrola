    def _wczytaj_z_pliku(self, path):
        if path.lower().endswith(".json"):
            try:
                data = _load_json(path)
                self._zastosuj_plan_z_json(data)
                messagebox.showinfo("Wczytano", f"Wczytano plan z:\n{path}")
            except Exception as e:
                messagebox.showerror("Błąd", f"Nie udało się wczytać JSON:\n{e}")
        elif path.lower().endswith(".csv"):
            try:
                data = self._wczytaj_csv_plan(path)
                self._zastosuj_plan_z_json(data)
                messagebox.showinfo("Wczytano", f"Wczytano plan z:\n{path}")
            except Exception as e:
                messagebox.showerror("Błąd", f"Nie udało się wczytać CSV:\n{e}")
        else:
            messagebox.showwarning("Format", "Obsługiwane formaty: .json lub .csv")

    def _wczytaj_csv_plan(self, path):
        meta = {"nr_rysunku":"", "autor":"", "sprawdzil":"", "zatwierdzil":"", "data":"", "zapisano":"", "czestotliwosc":"", "plik_rysunku":"", "rodzaje_kontroli":[]}
        cechy = []
        with open(path, "r", encoding="utf-8-sig") as f:
            lines = f.readlines()
        i = 0
        while i < len(lines) and lines[i].startswith("#"):
            ln = lines[i].strip()
            if ln.startswith("# Nr rysunku;"): meta["nr_rysunku"] = ln.split(";", 1)[1].strip()
            elif ln.startswith("# Autor;"): meta["autor"] = ln.split(";", 1)[1].strip()
            elif ln.startswith("# Sprawdził;"): meta["sprawdzil"] = ln.split(";", 1)[1].strip()
            elif ln.startswith("# Zatwierdził;"): meta["zatwierdzil"] = ln.split(";", 1)[1].strip()
            elif ln.startswith("# Data utworzenia;"): meta["data"] = ln.split(";", 1)[1].strip()
            elif ln.startswith("# Zapisano;"): meta["zapisano"] = ln.split(";", 1)[1].strip()
            elif ln.startswith("# Częstotliwość domyślna;"): meta["czestotliwosc"] = ln.split(";", 1)[1].strip()
            elif ln.startswith("# Plik rysunku;"): meta["plik_rysunku"] = ln.split(";", 1)[1].strip()
            elif ln.startswith("# Rodzaj kontroli;"):
                val = ln.split(";", 1)[1].strip()
                meta["rodzaje_kontroli"] = [s.strip() for s in val.split(",") if s.strip()]
            i += 1
        while i < len(lines) and "Typ cechy" not in lines[i]: i += 1
        i += 1
        for j in range(i, len(lines)):
            row = lines[j].rstrip("\n")
            if not row: continue
            parts = row.split(";")
            if len(parts) < 10:  # nowy format 10 kolumn
                # zgodność wsteczna (stare 7 kol): dopełnij pustymi polami
                parts = (parts + ["", "", ""])[:10]
            cechy.append({
                "typ": parts[0], "opis": parts[1], "nominal": parts[2],
                "tol_minus": parts[3], "tol_plus": parts[4], "jednostka": parts[5],
                "narzedzie": parts[6], "kto_mierzy": parts[7],
                "czest_cechy": parts[8], "czest_cechy_inne": parts[9],
            })
        return {"metadane": meta, "cechy": cechy}

    def _zastosuj_plan_z_json(self, data):
        meta = data.get("metadane", {})
        self.ent_rys.delete(0, tk.END); self.ent_rys.insert(0, meta.get("nr_rysunku",""))
        autor = meta.get("autor","")
        sprawdzil = meta.get("sprawdzil", "")
        zatwierdzil = meta.get("zatwierdzil", "")
        for person in (autor, sprawdzil, zatwierdzil):
            if person and person not in self.autorzy:
                self.autorzy.append(person)
        self.cb_autor["values"] = self.autorzy
        self.cb_sprawdzil["values"] = self.autorzy
        self.cb_zatwierdzil["values"] = self.autorzy

        if autor:
            self.cb_autor.set(autor)
        elif self.autorzy:
            self.cb_autor.set(self.autorzy[0])

        if sprawdzil:
            self.cb_sprawdzil.set(sprawdzil)
        elif self.autorzy:
            self.cb_sprawdzil.set(self.autorzy[0])

        if zatwierdzil:
            self.cb_zatwierdzil.set(zatwierdzil)
        elif self.autorzy:
            self.cb_zatwierdzil.set(self.autorzy[0])

        cz = meta.get("czestotliwosc","")
        if cz and cz not in CZESTOTLIWOSCI:
            self.cb_czest.set("Inne (wpisz ręcznie poniżej)"); self.ent_czest_inne.delete(0, tk.END); self.ent_czest_inne.insert(0, cz)
        else:
