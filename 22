def lista_wygasajacych(narzedzia, dni=DNI_ALERTU):
    expired, soon = [], []
    today = _today()
    horizon = today + datetime.timedelta(days=dni)
    for it in narzedzia:
        v = _parse_date(it.get("valid_to",""))
        if not v: continue
        if v < today: expired.append(it)
        elif today <= v <= horizon: soon.append(it)
    return expired, soon

@dataclass
class CapabilityResult:
    n: int
    mean: float
    sigma: float
    cp: float
    cpk: float
    error: str = ""


def _calculate_capability(values, lsl, usl):
    n = len(values)
    if n == 0:
        return CapabilityResult(0, 0.0, 0.0, 0.0, 0.0, "Brak danych do obliczeń.")

    mean = statistics.fmean(values)
    if n < 2:
        return CapabilityResult(n, mean, 0.0, 0.0, 0.0, "Za mało danych do obliczeń.")

    try:
        sigma = float(statistics.stdev(values))
    except statistics.StatisticsError:
        return CapabilityResult(n, mean, 0.0, 0.0, 0.0, "Brak rozrzutu (σ=0). Cp/Cpk nieokreślone.")
    except Exception as exc:
        return CapabilityResult(n, mean, 0.0, 0.0, 0.0, f"Błąd obliczeń odchylenia: {exc}")

    if sigma <= 0.0:
        return CapabilityResult(n, mean, 0.0, 0.0, 0.0, "Brak rozrzutu (σ=0). Cp/Cpk nieokreślone.")

    cp = (usl - lsl) / (6.0 * sigma)
    cpk = min((usl - mean) / (3.0 * sigma), (mean - lsl) / (3.0 * sigma))
    return CapabilityResult(n, mean, sigma, cp, cpk, "")


# ===== tolerancje CSV =====
def tolerancje_z_csv(path):
    out = []
    with open(path, "r", encoding="utf-8-sig") as f:
        reader = csv.reader(f, delimiter=";")
        for row in reader:
            if not row or row[0].startswith("#") or len(row) < 6: 
                continue
            symbol, typ, dmin, dmax, ES, EI = row[:6]
            try:
                out.append({
                    "symbol": symbol.strip(),
                    "typ": (typ.strip() or "any"),
                    "d_min": float(str(dmin).replace(",", ".")),
                    "d_max": float(str(dmax).replace(",", ".")),
                    "ES_um": int(float(str(ES).replace(",", "."))),
                    "EI_um": int(float(str(EI).replace(",", "."))),
                })
            except Exception:
                pass
    return out

def tolerancje_do_csv(path, lista):
    with open(path, "w", encoding="utf-8-sig", newline="") as f:
        w = csv.writer(f, delimiter=";")
        w.writerow(["symbol","typ","d_min_mm","d_max_mm","ES_um","EI_um"])
        for t in lista:
            w.writerow([t.get("symbol",""), t.get("typ","any"),
                        t.get("d_min",""), t.get("d_max",""),
                        t.get("ES_um",""), t.get("EI_um","")])

