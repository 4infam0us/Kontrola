def _http_get(url, timeout=4.0, headers=None):
    """Pobiera HTML z dashboardu."""
    req = urllib.request.Request(url, headers=(headers or {"User-Agent": "Mozilla/5.0"}))
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", errors="replace")


def _parse_all_machines(html):
    """
    Zwraca listę maszyn z aktualnym stanem:
    [{"machine": "...", "program": "...", "mode": "...", "alarm": "..."}]
    """
    blocks = re.findall(r'<div id=machine_name_display_area_\d+.*?gray_area"[^>]*>(.*?)</div>\s*</div>', html, re.S)
    machines = []

    for blk in blocks:
        m_name = re.search(r'id=machine_name_text_area_\d+[^>]*title="([^"]+)"', blk)
        machine = m_name.group(1).strip() if m_name else "?"

        m_prog = re.search(r'id=main_program_no_text_area_\d+[^>]*title="([^"]+)"', blk)
        program = m_prog.group(1).strip() if m_prog else ""

        modes = re.findall(r'<span class="machine_mode_status_string" title="([^"]+)"', blk)
        mode = " / ".join(modes) if modes else ""

        m_alarm = re.search(r'alarm_message_text_area_\d+[^>]*title="([^"]+)"', blk)
        alarm = m_alarm.group(1).strip() if m_alarm else ""

        machines.append({
            "machine": machine,
            "program": program,
            "mode": mode,
            "alarm": alarm
        })
    return machines

