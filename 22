class DialogListaEdytowalna(tk.Toplevel):
    def __init__(self, master, tytul, elementy, on_save):
        super().__init__(master)
        self.title(tytul); self.geometry("420x360"); self.resizable(False, False)
        self.on_save = on_save; self.elementy = elementy[:]
        frm = ttk.Frame(self, padding=8); frm.pack(fill="both", expand=True)
        self.listbox = tk.Listbox(frm, height=12); self.listbox.grid(row=0, column=0, rowspan=6, sticky="nsew")
        for el in self.elementy: self.listbox.insert(tk.END, el)
        sb = ttk.Scrollbar(frm, orient="vertical", command=self.listbox.yview)
        self.listbox.configure(yscrollcommand=sb.set); sb.grid(row=0, column=1, rowspan=6, sticky="ns")
        ttk.Label(frm, text="Nowy/edycja:").grid(row=0, column=2, padx=(10,0), sticky="w")
        self.entry = ttk.Entry(frm, width=28); self.entry.grid(row=1, column=2, padx=(10,0), sticky="w")

        def dodaj():
            val = self.entry.get().strip()
            if val: self.elementy.append(val); self.listbox.insert(tk.END, val); self.entry.delete(0, tk.END)
        def edytuj():
            idx = self.listbox.curselection()
            if not idx: return
            val = self.entry.get().strip()
            if val:
                i = idx[0]; self.elementy[i] = val
                self.listbox.delete(i); self.listbox.insert(i, val); self.listbox.select_set(i)
        def usun():
            idx = self.listbox.curselection()
            if not idx: return
            i = idx[0]; self.listbox.delete(i); del self.elementy[i]

        btns = ttk.Frame(frm); btns.grid(row=2, column=2, padx=(10,0), pady=6, sticky="w")
        ttk.Button(btns, text="Dodaj", command=dodaj).grid(row=0, column=0, padx=2)
        ttk.Button(btns, text="Zmień zaznaczony", command=edytuj).grid(row=0, column=1, padx=2)
        ttk.Button(btns, text="Usuń zaznaczony", command=usun).grid(row=0, column=2, padx=2)
        ttk.Separator(frm, orient="horizontal").grid(row=6, column=0, columnspan=3, sticky="ew", pady=8)
        bottom = ttk.Frame(frm); bottom.grid(row=7, column=0, columnspan=3, sticky="e")
        ttk.Button(bottom, text="Anuluj", command=self.destroy).grid(row=0, column=0, padx=4)
        ttk.Button(bottom, text="Zapisz", command=self._zapisz).grid(row=0, column=1, padx=4)

        frm.columnconfigure(0, weight=1)
        self.listbox.bind("<<ListboxSelect>>", lambda e: self._fill())
        self.transient(master); self.grab_set(); self.entry.focus_set()

    def _fill(self):
        idx = self.listbox.curselection()
        if idx:
            self.entry.delete(0, tk.END); self.entry.insert(0, self.elementy[idx[0]])

    def _zapisz(self):
        self.on_save(self.elementy); self.destroy()

