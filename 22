            except Exception:
                messagebox.showwarning("Edycja", "Wartość musi być liczbą.")
                return
            # przeliczenie
            self._recalc_for_record(rec)
            # zapisz do pamięci i odśwież wiersz
            self.pomiary[tv_idx] = rec
            vals = (rec["timestamp"], rec["nr_szt"], rec["opis_cechy"],
                    f'{rec["wartosc"]:.6f}', f'{rec["odchylka"]:.6f}', f'{rec["zapas"]:.6f}',
                    rec["wynik"], rec["kto_mierzy"], rec["narzedzie"])
