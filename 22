        self._refresh_tv()
        self.tv.bind("<<TreeviewSelect>>", self._on_select)
        self.transient(master); self.grab_set()

    def _refresh_tv(self):
        for i in self.tv.get_children(): self.tv.delete(i)
        for it in self.narzedzia: self.tv.insert("", tk.END, values=(it.get("name",""), it.get("last_cal",""), it.get("valid_to","")))

    def _on_select(self, event=None):
        sel = self.tv.selection()
        if not sel: return
        idx = self.tv.index(sel[0]); it = self.narzedzia[idx]
        self.ent_name.delete(0, tk.END); self.ent_name.insert(0, it.get("name",""))
        self.ent_last.delete(0, tk.END); self.ent_last.insert(0, it.get("last_cal",""))
        self.ent_valid.delete(0, tk.END); self.ent_valid.insert(0, it.get("valid_to",""))

    def _validate_dates(self, last_s, valid_s):
        if last_s and not _parse_date(last_s):
            messagebox.showwarning("Data", "Niepoprawny format 'Ostatnie wzorcowanie'. Użyj YYYY-MM-DD lub zostaw puste."); return False
        if valid_s and not _parse_date(valid_s):
            messagebox.showwarning("Data", "Niepoprawny format 'Ważne do'. Użyj YYYY-MM-DD lub zostaw puste."); return False
        return True

    def _dodaj(self):
        name = self.ent_name.get().strip(); last_s = self.ent_last.get().strip(); valid_s = self.ent_valid.get().strip()
        if not name: messagebox.showwarning("Brak danych", "Wpisz nazwę/opis narzędzia."); return
        if not self._validate_dates(last_s, valid_s): return
        self.narzedzia.append({"name": name, "last_cal": last_s, "valid_to": valid_s}); self._refresh_tv()
        self.ent_name.delete(0, tk.END); self.ent_last.delete(0, tk.END); self.ent_valid.delete(0, tk.END)

    def _zmien(self):
        sel = self.tv.selection()
        if not sel: messagebox.showinfo("Wybór", "Zaznacz narzędzie do edycji."); return
        idx = self.tv.index(sel[0])
        name = self.ent_name.get().strip(); last_s = self.ent_last.get().strip(); valid_s = self.ent_valid.get().strip()
        if not name: messagebox.showwarning("Brak danych", "Wpisz nazwę/opis narzędzia."); return
        if not self._validate_dates(last_s, valid_s): return
        self.narzedzia[idx] = {"name": name, "last_cal": last_s, "valid_to": valid_s}; self._refresh_tv()
        self.tv.selection_set(self.tv.get_children()[idx])

    def _usun(self):
        sel = self.tv.selection()
        if not sel: messagebox.showinfo("Wybór", "Zaznacz narzędzie do usunięcia."); return
        idx = self.tv.index(sel[0])
        if messagebox.askyesno("Potwierdź", "Usunąć zaznaczone narzędzie?"):
            del self.narzedzia[idx]; self._refresh_tv()

    def _zapisz(self):
        self.on_save(self.narzedzia); self.destroy()
        
    def _eksport_listy(self):
        path = filedialog.asksaveasfilename(
            title="Zapisz listę narzędzi",
            defaultextension=".json",
            filetypes=[("JSON", "*.json"), ("Wszystkie pliki", "*.*")],
        )
        if not path:
            return
        try:
            _save_json(path, self.narzedzia)
            messagebox.showinfo("Zapis", f"Zapisano listę narzędzi:\n{path}")
        except Exception as exc:
            messagebox.showerror("Zapis", f"Nie udało się zapisać listy:\n{exc}")

    def _import_listy(self):
        path = filedialog.askopenfilename(
            title="Wczytaj listę narzędzi",
            filetypes=[("JSON", "*.json"), ("Wszystkie pliki", "*.*")],
        )
        if not path:
            return
        try:
            data = _load_json(path)
            if not isinstance(data, list):
                raise ValueError("Plik nie zawiera listy narzędzi.")
            cleaned = []
            for it in data:
                if isinstance(it, dict):
                    cleaned.append({
                        "name": (it.get("name") or "").strip(),
                        "last_cal": (it.get("last_cal") or "").strip(),
                        "valid_to": (it.get("valid_to") or "").strip(),
                    })
                elif isinstance(it, str):
                    cleaned.append({"name": it.strip(), "last_cal": "", "valid_to": ""})
            self.narzedzia = [c for c in cleaned if c.get("name")]
            self._refresh_tv()
            messagebox.showinfo("Import", f"Wczytano {len(self.narzedzia)} narzędzi.")
        except Exception as exc:
            messagebox.showerror("Import", f"Nie udało się wczytać listy:\n{exc}")


