                        r["timestamp"],
                        self.stanowisko_id,
                        r["nr_szt"],
                        r["idx_cechy"],
                        r["opis_cechy"],
                        f'{r["wartosc"]:.6f}',
                        f'{r["odchylka"]:.6f}',
                        f'{r["zapas"]:.6f}',
                        r["wynik"],
                        r["kto_mierzy"],
                        r["narzedzie"],
                        f'{r["nominal"]:.6f}',
                        f'{r["lsl"]:.6f}',
                        f'{r["usl"]:.6f}',
                        meta.get("nr_rysunku", ""),
                        meta.get("autor", ""),
                        meta.get("data", ""),
                        self.pom_plan_path if (self.var_pom_src.get() == "file") else "",
                    ])
        except Exception as e:
            self._history_queue.extend(records)
            messagebox.showwarning("Historia pomiarów", f"Nie udało się zapisać historii:\n{e}")

