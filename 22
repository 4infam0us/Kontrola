    def _refresh_tv(self):
        for i in self.tv.get_children(): self.tv.delete(i)
        for t in self.tolerancje:
            self.tv.insert("", tk.END, values=(t.get("symbol",""), t.get("typ",""), t.get("d_min",""), t.get("d_max",""), t.get("ES_um",""), t.get("EI_um","")))

    def _on_select(self, event=None):
        sel = self.tv.selection()
        if not sel: return
        idx = self.tv.index(sel[0]); t = self.tolerancje[idx]
        self.e_symbol.delete(0, tk.END); self.e_symbol.insert(0, t.get("symbol",""))
        self.e_typ.set(t.get("typ","any"))
        self.e_dmin.delete(0, tk.END); self.e_dmin.insert(0, str(t.get("d_min","")))
        self.e_dmax.delete(0, tk.END); self.e_dmax.insert(0, str(t.get("d_max","")))
        self.e_ES.delete(0, tk.END); self.e_ES.insert(0, str(t.get("ES_um","")))
        self.e_EI.delete(0, tk.END); self.e_EI.insert(0, str(t.get("EI_um","")))

    def _read_fields(self):
        try:
            return {
                "symbol": self.e_symbol.get().strip(),
                "typ": (self.e_typ.get().strip() or "any"),
                "d_min": float(self.e_dmin.get().replace(",", ".")),
                "d_max": float(self.e_dmax.get().replace(",", ".")),
                "ES_um": int(float(self.e_ES.get().replace(",", "."))),
                "EI_um": int(float(self.e_EI.get().replace(",", "."))),
            }
        except Exception:
            messagebox.showwarning("Dane", "Uzupełnij poprawnie wszystkie pola (d_min, d_max, ES, EI).")
            return None

    def _dodaj(self):
        t = self._read_fields()
        if not t: return
        if not t["symbol"]: messagebox.showwarning("Dane", "Symbol jest obowiązkowy."); return
        if t["d_max"] <= t["d_min"]: messagebox.showwarning("Dane", "d_max musi być większe od d_min."); return
        self.tolerancje.append(t); self._refresh_tv()

    def _zmien(self):
        sel = self.tv.selection()
        if not sel: messagebox.showinfo("Wybór", "Zaznacz wpis do edycji."); return
        idx = self.tv.index(sel[0]); t = self._read_fields()
        if not t: return
        self.tolerancje[idx] = t; self._refresh_tv(); self.tv.selection_set(self.tv.get_children()[idx])

    def _usun(self):
        sel = self.tv.selection()
        if not sel: messagebox.showinfo("Wybór", "Zaznacz wpis do usunięcia."); return
        idx = self.tv.index(sel[0])
        if messagebox.askyesno("Potwierdź", "Usunąć zaznaczony wpis?"):
            del self.tolerancje[idx]; self._refresh_tv()

    def _eksport(self):
        path = filedialog.asksaveasfilename(title="Eksport tolerancji do CSV", defaultextension=".csv", filetypes=[("CSV","*.csv")])
        if not path: return
        tolerancje_do_csv(path, self.tolerancje); messagebox.showinfo("OK", f"Zapisano: {path}")

    def _import(self):
        path = filedialog.askopenfilename(title="Import tolerancji z CSV", filetypes=[("CSV","*.csv"),("Wszystkie","*.*")])
        if not path: return
        lst = tolerancje_z_csv(path)
        if not lst: messagebox.showwarning("Import", "Nie wczytano żadnych wpisów. Sprawdź plik."); return
        self.tolerancje = lst; self._refresh_tv(); messagebox.showinfo("OK", f"Wczytano {len(lst)} wpisów.")

    def _szablon(self):
        # mini-szablon
        path = filedialog.asksaveasfilename(title="Eksport szablonu CSV", defaultextension=".csv", filetypes=[("CSV","*.csv")])
        if not path: return
        sample = [
            ["H7","hole",30,50, 0,-25],
            ["h6","shaft",30,50, 0,-16],
            ["ISO2768-m","any",30,120, 300,-300],
        ]
        tolerancje_do_csv(path, [{"symbol":s,"typ":t,"d_min":d1,"d_max":d2,"ES_um":ES,"EI_um":EI} for s,t,d1,d2,ES,EI in sample])
        messagebox.showinfo("OK", f"Zapisano szablon: {path}")

    def _zapisz(self):
        self.on_save(self.tolerancje); self.destroy()

