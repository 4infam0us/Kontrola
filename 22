            return
        rec = dict(self.pomiary[tv_idx])  # kopia

        # okienko edycyjne
        dlg = tk.Toplevel(self)
        dlg.title("Edytuj pomiar"); dlg.geometry("420x220"); dlg.resizable(False, False)
        frm = ttk.Frame(dlg, padding=12); frm.pack(fill="both", expand=True)

        ttk.Label(frm, text="Cecha:").grid(row=0, column=0, sticky="e")
        ttk.Label(frm, text=rec["opis_cechy"]).grid(row=0, column=1, sticky="w", padx=6)

        ttk.Label(frm, text="Nr szt.:").grid(row=1, column=0, sticky="e")
        ent_szt = ttk.Entry(frm, width=12); ent_szt.grid(row=1, column=1, sticky="w", padx=6)
        ent_szt.insert(0, rec["nr_szt"])

        ttk.Label(frm, text="Wartość:").grid(row=2, column=0, sticky="e")
        ent_val = ttk.Entry(frm, width=16); ent_val.grid(row=2, column=1, sticky="w", padx=6)
        ent_val.insert(0, f'{rec["wartosc"]:.6f}')

        ttk.Label(frm, text="Kto mierzy:").grid(row=3, column=0, sticky="e")
        cb_kto = ttk.Combobox(frm, values=KTO_MIERZY, state="readonly", width=22)
        cb_kto.grid(row=3, column=1, sticky="w", padx=6); cb_kto.set(rec["kto_mierzy"])

        ttk.Label(frm, text="Czas (opcjonalnie):").grid(row=4, column=0, sticky="e")
        ent_ts = ttk.Entry(frm, width=24); ent_ts.grid(row=4, column=1, sticky="w", padx=6)
        ent_ts.insert(0, rec["timestamp"])

        def accept():
            try:
                rec["nr_szt"] = ent_szt.get().strip() or rec["nr_szt"]
